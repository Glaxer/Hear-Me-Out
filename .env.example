# Copy to .env and fill in from Supabase: Project Settings -> API
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: link to the public source code, shown in the site footer
# (the AGPL asks websites running this code to offer their source)
PUBLIC_SOURCE_URL=https://github.com/your-username/hear-me-out

# Optional: contact email shown on the privacy page (otherwise it links to the GitHub repo's issues)
PUBLIC_CONTACT_EMAIL=

# Optional: Cloudflare Turnstile site key ("verify you're human" on sign-up and login).
# The matching secret key goes in Supabase: Authentication -> Attack Protection.
PUBLIC_TURNSTILE_SITE_KEY=